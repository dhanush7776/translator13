# NVIDIA NIM API Key - Get yours at https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# Supabase Database Configuration
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Render Backend URL (set in Vercel for frontend to reach Render backend)
NEXT_PUBLIC_API_URL=https://build-to-ship-hack.onrender.com
